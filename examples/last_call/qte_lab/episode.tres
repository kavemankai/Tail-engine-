[gd_resource type="Resource" script_class="TEEpisode" format=3]

[ext_resource type="Script" path="res://addons/tale_engine/te_episode.gd" id="ep"]
[ext_resource type="Script" path="res://addons/tale_engine/te_step.gd" id="step"]
[ext_resource type="Script" path="res://addons/tale_engine/te_exit.gd" id="exit"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/manifest.tres" id="manifest"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/cast.tres" id="cast"]
[ext_resource type="Resource" path="res://examples/last_call/qte_lab/reaction.tres" id="sequence"]

[sub_resource type="Resource" id="exit"]
script = ExtResource("exit")
on = &"*"
next = &"END"

[sub_resource type="Resource" id="encounter"]
script = ExtResource("step")
id = &"lab"
kind = 2
location = "res://examples/last_call/episode_0/locations/bar.tscn"
sequence = ExtResource("sequence")
stage = &"FightStage"
cast = {&"player": "face_player", &"bartender": "behind_bar", &"stranger": "face_stranger"}
roles = {&"Player": &"player", &"Aggressor": &"stranger", &"Bartender": &"bartender"}
exits = Array[ExtResource("exit")]([SubResource("exit")])

[resource]
script = ExtResource("ep")
id = &"qte_lab"
title = "QTE interaction lab"
manifest = ExtResource("manifest")
cast = ExtResource("cast")
player = &"player"
entry = &"lab"
steps = Array[ExtResource("step")]([SubResource("encounter")])
