[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://addons/cinematic_action_director/cad_sequence.gd" id="seq"]
[ext_resource type="Script" path="res://addons/cinematic_action_director/cad_beat.gd" id="beat"]
[ext_resource type="Script" path="res://addons/cinematic_action_director/cad_gate.gd" id="gate"]
[ext_resource type="Script" path="res://addons/cinematic_action_director/cad_option.gd" id="option"]
[ext_resource type="Script" path="res://addons/cinematic_action_director/cad_interaction_spec.gd" id="spec"]
[ext_resource type="Script" path="res://addons/cinematic_action_director/compounds/cad_three_punch_template.gd" id="template"]

[sub_resource type="Resource" id="option1"]
script = ExtResource("option")
id = &"step_1"
action = &"cad_a"
label = "Punch 1"

[sub_resource type="Resource" id="spec1"]
script = ExtResource("spec")
id = &"combo_1"
option_id = &"step_1"
actions = Array[StringName]([&"cad_a"])

[sub_resource type="Resource" id="gate1"]
script = ExtResource("gate")
options = Array[ExtResource("option")]([SubResource("option1")])
interaction = SubResource("spec1")
window_seconds = 1.8

[sub_resource type="Resource" id="option2"]
script = ExtResource("option")
id = &"step_2"
action = &"cad_b"
label = "Punch 2"

[sub_resource type="Resource" id="spec2"]
script = ExtResource("spec")
id = &"combo_2"
option_id = &"step_2"
actions = Array[StringName]([&"cad_b"])

[sub_resource type="Resource" id="gate2"]
script = ExtResource("gate")
options = Array[ExtResource("option")]([SubResource("option2")])
interaction = SubResource("spec2")
window_seconds = 1.8

[sub_resource type="Resource" id="option3"]
script = ExtResource("option")
id = &"step_3"
action = &"cad_a"
label = "Punch 3"

[sub_resource type="Resource" id="spec3"]
script = ExtResource("spec")
id = &"combo_3"
option_id = &"step_3"
actions = Array[StringName]([&"cad_a"])

[sub_resource type="Resource" id="gate3"]
script = ExtResource("gate")
options = Array[ExtResource("option")]([SubResource("option3")])
interaction = SubResource("spec3")
window_seconds = 1.8

[resource]
script = ExtResource("template")
gates = Array[ExtResource("gate")]([SubResource("gate1"), SubResource("gate2"), SubResource("gate3")])
input_timelines = Array[StringName]([&"ready", &"ready", &"ready"])
action_timelines = Array[StringName]([&"jab", &"cross", &"hook"])
recovery_timelines = Array[StringName]([&"recover", &"recover", &"recover"])
