[gd_resource type="Resource" script_class="TEEpisode" format=3]

[ext_resource type="Script" path="res://addons/tale_engine/te_episode.gd" id="episode"]
[ext_resource type="Script" path="res://addons/tale_engine/te_step.gd" id="step"]
[ext_resource type="Script" path="res://addons/tale_engine/te_exit.gd" id="exit"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/manifest.tres" id="manifest"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/cast.tres" id="cast"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/dialogue/episode_0.dialogue" id="dlg"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/encounters/bar_fight/encounter.tres" id="fight"]
[ext_resource type="Resource" path="res://examples/last_call/episode_0/encounters/alley_chase/encounter.tres" id="chase"]

[sub_resource type="Resource" id="x_title_0"]
script = ExtResource("exit")
on = &"*"
next = &"bar_hub"

[sub_resource type="Resource" id="s_title"]
script = ExtResource("step")
id = &"title"
kind = 3
heading = "Episode 0"
body = "Last Call"
exits = Array[ExtResource("exit")]([SubResource("x_title_0")])

[sub_resource type="Resource" id="x_bar_hub_0"]
script = ExtResource("exit")
on = &"confront"
next = &"stranger_talk"

[sub_resource type="Resource" id="s_bar_hub"]
script = ExtResource("step")
id = &"bar_hub"
kind = 0
title = "The bar"
location = "res://examples/last_call/episode_0/locations/bar.tscn"
checkpoint = true
hub = &"main"
cast = {
&"player": "spawn",
&"bartender": "behind_bar",
&"stranger": "stranger_seat"
}
exits = Array[ExtResource("exit")]([SubResource("x_bar_hub_0")])

[sub_resource type="Resource" id="x_stranger_talk_0"]
script = ExtResource("exit")
on = &"paid"
next = &"paid_card"

[sub_resource type="Resource" id="x_stranger_talk_1"]
script = ExtResource("exit")
on = &"*"
next = &"bar_fight"

[sub_resource type="Resource" id="s_stranger_talk"]
script = ExtResource("step")
id = &"stranger_talk"
kind = 1
title = "The stranger"
location = "res://examples/last_call/episode_0/locations/bar.tscn"
checkpoint = true
dialogue = ExtResource("dlg")
cue = "stranger"
shot = &"wide"
cast = {
&"player": "face_player",
&"bartender": "behind_bar",
&"stranger": "face_stranger"
}
exits = Array[ExtResource("exit")]([SubResource("x_stranger_talk_0"), SubResource("x_stranger_talk_1")])

[sub_resource type="Resource" id="x_paid_card_0"]
script = ExtResource("exit")
on = &"*"
next = &"recap"

[sub_resource type="Resource" id="s_paid_card"]
script = ExtResource("step")
id = &"paid_card"
kind = 3
heading = "You paid. Twice."
body = "Nobody got hurt."
exits = Array[ExtResource("exit")]([SubResource("x_paid_card_0")])

[sub_resource type="Resource" id="x_bar_fight_0"]
script = ExtResource("exit")
on = &"*"
next = &"aftermath"

[sub_resource type="Resource" id="s_bar_fight"]
script = ExtResource("step")
id = &"bar_fight"
kind = 2
title = "The fight"
location = "res://examples/last_call/episode_0/locations/bar.tscn"
checkpoint = true
sequence = ExtResource("fight")
stage = &"FightStage"
cast = {
&"player": "face_player",
&"bartender": "behind_bar",
&"stranger": "face_stranger"
}
roles = {
&"Player": &"player",
&"Aggressor": &"stranger",
&"Bartender": &"bartender"
}
exits = Array[ExtResource("exit")]([SubResource("x_bar_fight_0")])

[sub_resource type="Resource" id="x_aftermath_0"]
script = ExtResource("exit")
on = &"*"
when = "outcome('bar_fight') == 'won'"
next = &"recap"

[sub_resource type="Resource" id="x_aftermath_1"]
script = ExtResource("exit")
on = &"*"
next = &"alley_chase"

[sub_resource type="Resource" id="s_aftermath"]
script = ExtResource("step")
id = &"aftermath"
kind = 1
location = "res://examples/last_call/episode_0/locations/bar.tscn"
dialogue = ExtResource("dlg")
cue = "aftermath"
shot = &"wide"
exits = Array[ExtResource("exit")]([SubResource("x_aftermath_0"), SubResource("x_aftermath_1")])

[sub_resource type="Resource" id="x_alley_chase_0"]
script = ExtResource("exit")
on = &"escaped"
next = &"recap"

[sub_resource type="Resource" id="x_alley_chase_1"]
script = ExtResource("exit")
on = &"*"
next = &"caught_talk"

[sub_resource type="Resource" id="s_alley_chase"]
script = ExtResource("step")
id = &"alley_chase"
kind = 2
title = "The alley"
location = "res://examples/last_call/episode_0/locations/alley.tscn"
checkpoint = true
sequence = ExtResource("chase")
stage = &"ChaseStage"
cast = {
&"player": "runner_start",
&"stranger": "pursuer_start"
}
roles = {
&"Runner": &"player",
&"Pursuer": &"stranger"
}
exits = Array[ExtResource("exit")]([SubResource("x_alley_chase_0"), SubResource("x_alley_chase_1")])

[sub_resource type="Resource" id="x_caught_talk_0"]
script = ExtResource("exit")
on = &"*"
next = &"recap"

[sub_resource type="Resource" id="s_caught_talk"]
script = ExtResource("step")
id = &"caught_talk"
kind = 1
location = "res://examples/last_call/episode_0/locations/alley.tscn"
dialogue = ExtResource("dlg")
cue = "caught"
shot = &"caught"
exits = Array[ExtResource("exit")]([SubResource("x_caught_talk_0")])

[sub_resource type="Resource" id="x_recap_0"]
script = ExtResource("exit")
on = &"*"
next = &"END"

[sub_resource type="Resource" id="s_recap"]
script = ExtResource("step")
id = &"recap"
kind = 3
card = 1
heading = "Your choices"
exits = Array[ExtResource("exit")]([SubResource("x_recap_0")])

[resource]
script = ExtResource("episode")
id = &"episode_0"
title = "Last Call"
manifest = ExtResource("manifest")
cast = ExtResource("cast")
player = &"player"
entry = &"title"
steps = Array[ExtResource("step")]([SubResource("s_title"), SubResource("s_bar_hub"), SubResource("s_stranger_talk"), SubResource("s_paid_card"), SubResource("s_bar_fight"), SubResource("s_aftermath"), SubResource("s_alley_chase"), SubResource("s_caught_talk"), SubResource("s_recap")])
