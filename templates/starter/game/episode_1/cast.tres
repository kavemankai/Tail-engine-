[gd_resource type="Resource" script_class="TECast" format=3]

[ext_resource type="Script" path="res://addons/tale_engine/te_cast.gd" id="cast"]
[ext_resource type="Script" path="res://addons/tale_engine/te_character.gd" id="char"]

[sub_resource type="Resource" id="player"]
script = ExtResource("char")
id = &"player"
display_name = "You"
colour = Color(0.32, 0.73, 0.78, 1)

[sub_resource type="Resource" id="friend"]
script = ExtResource("char")
id = &"friend"
display_name = "Friend"
colour = Color(0.84, 0.51, 0.38, 1)

[resource]
script = ExtResource("cast")
characters = Array[ExtResource("char")]([SubResource("player"), SubResource("friend")])
